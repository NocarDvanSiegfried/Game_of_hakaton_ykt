	audio narrator_voice "res://assets/audio/scene_01/voice/mercy_part7_finish_01_grab_shard.mp3" [volume="0" loop="false"]
	narrator: Айсен хватает осколок
	audio "res://assets/audio/scene_01/ice_shard_strike_2.wav" [volume="-4" loop="false"]
	audio narrator_voice "res://assets/audio/scene_01/voice/mercy_part7_finish_02_stab.mp3" [volume="0" loop="false"]
	narrator: и вонзает в грудь демона.
	[background arg="res://assets/art/backgrounds/scene_01/bg_s1_tongus_destroyed.png" fade="0.5"]
	audio "res://assets/audio/scene_01/tongus_collapse_1.wav" [volume="-8" loop="false"]
	audio narrator_voice "res://assets/audio/scene_01/voice/mercy_part7_finish_03_crunch.mp3" [volume="0" loop="false"]
	narrator: Тонгус с хрустом
