audio "res://assets/audio/scene_01/ice_dive_2.wav" [volume="-6" loop="false"]
audio narrator_voice "res://assets/audio/scene_01/voice/after_part8_20_fade_black.mp3" [volume="0" loop="false"]
[background arg="res://assets/art/backgrounds/scene_01/bg_s1_lower_world_transition.png" fade="1.0"]
narrator: Экран темнеет.

audio narrator_voice "res://assets/audio/scene_01/voice/after_part8_21_chapter_end.mp3" [volume="0" loop="false"]
